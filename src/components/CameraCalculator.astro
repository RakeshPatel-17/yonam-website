---
// src/components/CameraCalculator.astro
---

<section id="calculator" class="py-20 bg-slate-900/80 border-b border-slate-800 text-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-cyan-400 font-semibold text-xs uppercase tracking-widest">Interactive Estimator</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 tracking-tight">Configure Your Custom Surveillance System</h2>
      <p class="text-slate-400 mt-4 text-base">
        Select your property parameters to immediately calculate recommended hardware, channel capacity, and storage requirements.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Configurator Form -->
      <div class="lg:col-span-7 bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <span>⚙️</span> System Parameters
        </h3>

        <!-- Property Type -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Property Environment</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <button type="button" data-prop="home" class="prop-btn px-3 py-2.5 rounded-lg border border-cyan-400 bg-cyan-400/10 text-cyan-300 text-xs font-semibold text-center hover:border-cyan-300 transition-colors">
              🏡 Residence
            </button>
            <button type="button" data-prop="office" class="prop-btn px-3 py-2.5 rounded-lg border border-slate-800 bg-slate-900 text-slate-300 text-xs font-semibold text-center hover:border-slate-700 transition-colors">
              🏢 Office
            </button>
            <button type="button" data-prop="retail" class="prop-btn px-3 py-2.5 rounded-lg border border-slate-800 bg-slate-900 text-slate-300 text-xs font-semibold text-center hover:border-slate-700 transition-colors">
              🛍️ Retail
            </button>
            <button type="button" data-prop="warehouse" class="prop-btn px-3 py-2.5 rounded-lg border border-slate-800 bg-slate-900 text-slate-300 text-xs font-semibold text-center hover:border-slate-700 transition-colors">
              🏭 Warehouse
            </button>
          </div>
        </div>

        <!-- Indoor Cameras Slider -->
        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <label for="calc-indoor" class="font-semibold text-slate-300">Indoor Cameras (Dome / Turret)</label>
            <span id="calc-indoor-val" class="font-mono text-cyan-400 font-bold bg-slate-900 px-2 py-0.5 rounded border border-slate-800">2 Units</span>
          </div>
          <input
            id="calc-indoor"
            type="range"
            min="0"
            max="16"
            value="2"
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
          />
        </div>

        <!-- Outdoor Cameras Slider -->
        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <label for="calc-outdoor" class="font-semibold text-slate-300">Outdoor Weatherproof Cameras (Bullet / PTZ)</label>
            <span id="calc-outdoor-val" class="font-mono text-cyan-400 font-bold bg-slate-900 px-2 py-0.5 rounded border border-slate-800">4 Units</span>
          </div>
          <input
            id="calc-outdoor"
            type="range"
            min="0"
            max="16"
            value="4"
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
          />
        </div>

        <!-- Night Vision Selection -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Optical Night Vision Mode</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <label class="flex items-center gap-2 p-3 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 cursor-pointer">
              <input type="radio" name="night-vision" value="standard" class="accent-cyan-400" />
              <div>
                <div class="font-bold text-white">Standard Infrared (30m)</div>
                <div class="text-[11px] text-slate-400">Crisp monochrome night feed</div>
              </div>
            </label>
            <label class="flex items-center gap-2 p-3 rounded-lg bg-slate-900 border border-cyan-500/40 hover:border-cyan-400 cursor-pointer">
              <input type="radio" name="night-vision" value="color" checked class="accent-cyan-400" />
              <div>
                <div class="font-bold text-white">Full-Color Night Vision (50m)</div>
                <div class="text-[11px] text-cyan-400">F1.0 Super Aperture optical sensor</div>
              </div>
            </label>
          </div>
        </div>

        <!-- Recording Storage -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Continuous Backup Storage</label>
          <div class="grid grid-cols-3 gap-2 text-xs">
            <label class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-center cursor-pointer hover:border-slate-700">
              <input type="radio" name="storage" value="15" class="sr-only storage-radio" />
              <div class="font-bold text-white">15 Days</div>
              <div class="text-[10px] text-slate-500 font-mono">1TB HDD</div>
            </label>
            <label class="p-2.5 rounded-lg bg-slate-900 border border-cyan-400 text-center cursor-pointer hover:border-cyan-300">
              <input type="radio" name="storage" value="30" checked class="sr-only storage-radio" />
              <div class="font-bold text-cyan-300">30 Days</div>
              <div class="text-[10px] text-cyan-400 font-mono">2TB Surveillance Grade</div>
            </label>
            <label class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 text-center cursor-pointer hover:border-slate-700">
              <input type="radio" name="storage" value="60" class="sr-only storage-radio" />
              <div class="font-bold text-white">60 Days</div>
              <div class="text-[10px] text-slate-500 font-mono">4TB Enterprise RAID</div>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Recommendation Panel -->
      <div class="lg:col-span-5 bg-gradient-to-b from-slate-900 to-slate-950 border border-cyan-500/30 rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl relative">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-cyan-400 font-semibold">Recommended Package</span>
            <h3 id="rec-package-title" class="text-xl font-extrabold text-white">YONAM 8-CH Pro Security</h3>
          </div>
          <span class="px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold">
            OPTIMAL FIT
          </span>
        </div>

        <!-- Calculated Specs List -->
        <div class="space-y-3.5 text-xs">
          <div class="flex justify-between py-1.5 border-b border-slate-800/80">
            <span class="text-slate-400">Total Optical Channels:</span>
            <span id="rec-total-cams" class="font-mono font-bold text-white">6 Cameras</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-800/80">
            <span class="text-slate-400">Recorder Architecture:</span>
            <span id="rec-nvr" class="font-mono font-bold text-cyan-400">8-Channel 4K PoE NVR</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-800/80">
            <span class="text-slate-400">Surveillance Storage:</span>
            <span id="rec-storage" class="font-mono font-bold text-white">2TB Dedicated Video HDD</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-800/80">
            <span class="text-slate-400">Mobile Remote Viewing:</span>
            <span class="font-mono font-bold text-emerald-400">Included (iOS/Android)</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-slate-800/80">
            <span class="text-slate-400">Professional Cable & Conduit:</span>
            <span class="font-mono font-bold text-white">Cat6 Shielded Copper</span>
          </div>
          <div class="flex justify-between py-1.5">
            <span class="text-slate-400">Warranty & AMC:</span>
            <span class="font-mono font-bold text-white">1 Year Comprehensive</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs space-y-1">
          <div class="text-cyan-400 font-semibold flex items-center gap-1.5">
            <span>🛡️</span> Free On-Site Calibration Included
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Our engineers verify camera angles, night illumination, and motion zones before final handover.
          </p>
        </div>

        <button
          type="button"
          id="btn-apply-quote"
          class="w-full py-3 px-4 rounded-xl font-bold text-slate-950 bg-gradient-to-r from-cyan-400 to-sky-400 hover:from-cyan-300 hover:to-sky-300 shadow-lg shadow-cyan-500/20 text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
        >
          Request Quote with this Setup &rarr;
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  function setupCalculator() {
    const indoorInput = document.getElementById('calc-indoor') as HTMLInputElement | null;
    const outdoorInput = document.getElementById('calc-outdoor') as HTMLInputElement | null;
    const indoorVal = document.getElementById('calc-indoor-val');
    const outdoorVal = document.getElementById('calc-outdoor-val');
    const totalCamsEl = document.getElementById('rec-total-cams');
    const nvrEl = document.getElementById('rec-nvr');
    const packageTitle = document.getElementById('rec-package-title');
    const storageEl = document.getElementById('rec-storage');
    const applyBtn = document.getElementById('btn-apply-quote');
    const propBtns = document.querySelectorAll('.prop-btn');
    const storageRadios = document.querySelectorAll('.storage-radio');

    if (!indoorInput || !outdoorInput || !indoorVal || !outdoorVal || !totalCamsEl || !nvrEl || !packageTitle || !storageEl) {
      return;
    }

    let selectedProp = 'Home';

    propBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        propBtns.forEach((b) => {
          b.classList.remove('border-cyan-400', 'bg-cyan-400/10', 'text-cyan-300');
          b.classList.add('border-slate-800', 'bg-slate-900', 'text-slate-300');
        });
        btn.classList.add('border-cyan-400', 'bg-cyan-400/10', 'text-cyan-300');
        btn.classList.remove('border-slate-800', 'bg-slate-900', 'text-slate-300');
        selectedProp = (btn.textContent || '').trim();
        recalc();
      });
    });

    storageRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        const parentLabels = document.querySelectorAll('input[name="storage"]');
        parentLabels.forEach((r) => {
          const parent = r.closest('label');
          if (parent) {
            parent.classList.remove('border-cyan-400');
            parent.classList.add('border-slate-800');
          }
        });
        const currentParent = radio.closest('label');
        if (currentParent) {
          currentParent.classList.remove('border-slate-800');
          currentParent.classList.add('border-cyan-400');
        }
        recalc();
      });
    });

    function recalc() {
      const indoor = parseInt(indoorInput?.value || '0', 10);
      const outdoor = parseInt(outdoorInput?.value || '0', 10);
      const total = indoor + outdoor;

      if (indoorVal) indoorVal.textContent = `${indoor} Units`;
      if (outdoorVal) outdoorVal.textContent = `${outdoor} Units`;
      if (totalCamsEl) totalCamsEl.textContent = `${total} Cameras (${indoor} Indoor + ${outdoor} Outdoor)`;

      // Determine Recorder Channel
      let nvrType = '4-Channel 4K PoE NVR';
      let pkg = 'Starter Protection';
      if (total <= 4) {
        nvrType = '4-Channel 4K PoE NVR';
        pkg = `YONAM 4-CH ${selectedProp} Setup`;
      } else if (total <= 8) {
        nvrType = '8-Channel 4K PoE NVR';
        pkg = `YONAM 8-CH ${selectedProp} Pro`;
      } else if (total <= 16) {
        nvrType = '16-Channel 4K Enterprise NVR';
        pkg = `YONAM 16-CH Advanced Grid`;
      } else {
        nvrType = '32-Channel Commercial RAID NVR';
        pkg = `YONAM Multi-Building Enterprise`;
      }

      if (nvrEl) nvrEl.textContent = nvrType;
      if (packageTitle) packageTitle.textContent = pkg;

      // Storage
      const selectedStorage = (document.querySelector('input[name="storage"]:checked') as HTMLInputElement)?.value || '30';
      if (storageEl) {
        if (selectedStorage === '15') storageEl.textContent = '1TB Dedicated Video HDD (15 Days)';
        else if (selectedStorage === '30') storageEl.textContent = '2TB Surveillance Grade (30 Days)';
        else storageEl.textContent = '4TB Enterprise Storage (60 Days)';
      }
    }

    indoorInput.addEventListener('input', recalc);
    outdoorInput.addEventListener('input', recalc);

    // Apply configuration into contact form
    if (applyBtn) {
      applyBtn.addEventListener('click', () => {
        const contactSection = document.getElementById('why-us') || document.getElementById('contact');
        const notesArea = document.getElementById('notes') as HTMLTextAreaElement | null;
        const camerasSelect = document.getElementById('cameras-needed') as HTMLSelectElement | null;

        const indoor = indoorInput.value;
        const outdoor = outdoorInput.value;
        const total = parseInt(indoor, 10) + parseInt(outdoor, 10);

        if (notesArea) {
          notesArea.value = `[Configured System]: ${selectedProp} with ${total} Cameras (${indoor} Indoor, ${outdoor} Outdoor), ${nvrEl?.textContent}, ${storageEl?.textContent}.`;
        }

        if (camerasSelect) {
          if (total <= 4) camerasSelect.value = '4';
          else if (total <= 8) camerasSelect.value = '8';
          else if (total <= 16) camerasSelect.value = '16';
          else camerasSelect.value = '32+';
        }

        contactSection?.scrollIntoView({ behavior: 'smooth' });
      });
    }

    recalc();
  }

  // Run on first load
  setupCalculator();
  // Support Astro View Transitions if enabled
  document.addEventListener('astro:page-load', setupCalculator);
</script>
