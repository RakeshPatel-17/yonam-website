---
// src/components/ContactSection.astro
---

<section id="why-us" class="py-20 bg-slate-900/40 border-b border-slate-800 text-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Why Choose YONAM -->
      <div class="lg:col-span-6 space-y-6">
        <span class="text-cyan-400 font-semibold text-xs uppercase tracking-widest">Why YONAM</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Engineered Security Architecture You Can Depend On
        </h2>
        <p class="text-slate-300 text-base leading-relaxed">
          Unlike retail plug-and-play kits, YONAM designs, installs, and warranties professional-tier surveillance infrastructure built to withstand environmental stress, power surges, and tampering.
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Certified Field Technicians</h3>
              <p class="text-xs text-slate-400 mt-0.5">Strict adherence to safety standards, structured conduit cabling, and neat rack termination.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Full Privacy & Encryption</h3>
              <p class="text-xs text-slate-400 mt-0.5">Zero backdoors. AES-256 encrypted feeds with localized storage options to ensure confidential data stays protected.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Rapid On-Site Support</h3>
              <p class="text-xs text-slate-400 mt-0.5">Fast SLA-backed maintenance and emergency camera replacements to eliminate surveillance blind spots.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Site Survey & Consultation Request -->
      <div class="lg:col-span-6">
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl">
          <h3 class="text-xl font-bold text-white mb-2">Request a Free Site Survey</h3>
          <p class="text-xs text-slate-400 mb-6">Our security consultant will assess your floor plan, camera angles, and provide an itemized quote.</p>

          <form action="mailto:quotes@yonamsecurity.com" method="GET" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-medium text-slate-300 mb-1">Full Name</label>
                <input
                  type="text"
                  id="name"
                  name="subject"
                  required
                  placeholder="e.g. John Doe"
                  class="w-full px-3.5 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400 placeholder:text-slate-500"
                />
              </div>
              <div>
                <label for="phone" class="block text-xs font-medium text-slate-300 mb-1">Phone Number</label>
                <input
                  type="tel"
                  id="phone"
                  required
                  placeholder="+91 98765 43210"
                  class="w-full px-3.5 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400 placeholder:text-slate-500"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="property-type" class="block text-xs font-medium text-slate-300 mb-1">Property Type</label>
                <select
                  id="property-type"
                  class="w-full px-3.5 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400"
                >
                  <option value="commercial">Commercial / Office</option>
                  <option value="warehouse">Warehouse / Industrial</option>
                  <option value="residential">Villa / Apartment</option>
                  <option value="retail">Retail Showroom</option>
                </select>
              </div>
              <div>
                <label for="cameras-needed" class="block text-xs font-medium text-slate-300 mb-1">Estimated Cameras</label>
                <select
                  id="cameras-needed"
                  class="w-full px-3.5 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400"
                >
                  <option value="4">1 - 4 Cameras</option>
                  <option value="8">5 - 8 Cameras</option>
                  <option value="16">9 - 16 Cameras</option>
                  <option value="32+">16+ Enterprise System</option>
                </select>
              </div>
            </div>

            <div>
              <label for="notes" class="block text-xs font-medium text-slate-300 mb-1">Project Details / Requirements</label>
              <textarea
                id="notes"
                name="body"
                rows="3"
                placeholder="Mention specific areas, remote viewing needs, or access control..."
                class="w-full px-3.5 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400 placeholder:text-slate-500"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 rounded-xl font-bold text-slate-950 bg-gradient-to-r from-cyan-400 to-sky-400 hover:from-cyan-300 hover:to-sky-300 shadow-lg shadow-cyan-500/20 text-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
            >
              Submit Site Survey Request
            </button>
            <p class="text-[11px] text-center text-slate-500">
              No obligation. We respond within 24 hours with custom recommendations.
            </p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

