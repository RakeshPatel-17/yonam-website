---
// src/components/Products.astro
const products = [
  {
    category: 'Dome Cameras',
    title: 'Vandal-Resistant 4K Dome Camera',
    description: 'Discreet IK10 impact-rated dome housing with 30m infrared vision, wide-angle 110° lens, and built-in audio recording.',
    specs: ['4K UHD 8MP', 'IK10 Vandal-Proof', 'IP67 Weatherproof', 'Power over Ethernet (PoE)'],
    badge: 'Indoor / Outdoor',
    type: 'dome',
  },
  {
    category: 'Bullet Cameras',
    title: 'Long-Range Optical Bullet Camera',
    description: 'Engineered for long perimeters, gate entrances, and building exteriors with motorized zoom and up to 80m smart IR distance.',
    specs: ['5MP / 4K Options', '80m Smart IR', 'Motorized Varifocal', 'Vehicle Plate Recognition'],
    badge: 'Perimeter Security',
    type: 'bullet',
  },
  {
    category: 'PTZ Cameras',
    title: '360° AI Auto-Tracking PTZ',
    description: 'High-speed 360-degree endless pan with 32x optical zoom, auto-tracking intruders, and customizable patrolling tours.',
    specs: ['32x Optical Zoom', 'AI Auto-Tracking', '360° Continuous Pan', 'Active Siren & Strobe'],
    badge: 'Large Area',
    type: 'ptz',
  },
  {
    category: 'Recording & Storage',
    title: 'Enterprise NVR Storage Systems',
    description: '8 to 64-channel Network Video Recorders with RAID redundancy, H.265+ ultra compression, and high-speed multi-screen HDMI output.',
    specs: ['Up to 64 Channels', 'RAID 1/5 Storage', 'H.265+ Compression', 'Cloud Auto-Backup'],
    badge: 'Core Infrastructure',
    type: 'nvr',
  },
];
---

<section id="products" class="py-20 bg-slate-950 text-slate-100 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-cyan-400 font-semibold text-xs uppercase tracking-widest">Hardware Lineup</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 tracking-tight">Industry-Grade Surveillance Equipment</h2>
      <p class="text-slate-400 mt-4 text-base">
        High-performance optical sensors, heavy-duty weatherproofing, and smart edge AI built for uncompromised reliability.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.map((item) => (
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between hover:border-cyan-500/50 hover:shadow-xl hover:shadow-cyan-950/20 transition-all duration-300 group">
          <div>
            <!-- Visual Camera Graphic Container -->
            <div class="w-full aspect-[4/3] rounded-xl bg-slate-950 border border-slate-800/80 mb-5 flex items-center justify-center p-4 relative overflow-hidden group-hover:border-slate-700 transition-colors">
              <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/5 to-transparent pointer-events-none"></div>
              
              {item.type === 'dome' && (
                <svg class="w-24 h-24 text-slate-400 group-hover:text-cyan-400 transition-colors" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <!-- Base Ring -->
                  <path d="M15 45 C15 30, 85 30, 85 45 L88 50 C88 52, 12 52, 12 50 Z" fill="#1e293b" stroke="currentColor" stroke-width="2"/>
                  <!-- Translucent Dome Bubble -->
                  <path d="M22 50 C22 78, 78 78, 78 50 Z" fill="#0f172a" fill-opacity="0.8" stroke="currentColor" stroke-width="2"/>
                  <!-- Inner Camera Eye -->
                  <circle cx="50" cy="56" r="14" fill="#020617" stroke="#38bdf8" stroke-width="2"/>
                  <!-- Lens Core -->
                  <circle cx="50" cy="56" r="7" fill="#0ea5e9"/>
                  <circle cx="48" cy="54" r="2.5" fill="#e0f2fe"/>
                  <!-- IR LED Array Indicator -->
                  <circle cx="38" cy="50" r="1.5" fill="#ef4444"/>
                  <circle cx="62" cy="50" r="1.5" fill="#ef4444"/>
                  <circle cx="38" cy="62" r="1.5" fill="#ef4444"/>
                  <circle cx="62" cy="62" r="1.5" fill="#ef4444"/>
                </svg>
              )}

              {item.type === 'bullet' && (
                <svg class="w-24 h-24 text-slate-400 group-hover:text-cyan-400 transition-colors" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <!-- Wall Mount Bracket -->
                  <path d="M12 65 L24 65 L28 55 L28 45 L12 45 Z" fill="#1e293b" stroke="currentColor" stroke-width="2"/>
                  <!-- Articulated Arm -->
                  <path d="M28 50 L42 46" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                  <!-- Camera Barrel Cylinder -->
                  <rect x="40" y="34" width="42" height="26" rx="4" fill="#0f172a" stroke="currentColor" stroke-width="2"/>
                  <!-- Sun Visor Hood -->
                  <path d="M36 32 L86 32 L84 36 L38 36 Z" fill="#1e293b" stroke="currentColor" stroke-width="1.5"/>
                  <!-- Front Lens Face -->
                  <ellipse cx="82" cy="47" rx="3" ry="12" fill="#020617" stroke="#38bdf8" stroke-width="1.5"/>
                  <!-- Lens Glass Reflection -->
                  <circle cx="82" cy="47" r="4" fill="#0ea5e9"/>
                  <circle cx="81" cy="45" r="1.5" fill="#ffffff"/>
                </svg>
              )}

              {item.type === 'ptz' && (
                <svg class="w-24 h-24 text-slate-400 group-hover:text-cyan-400 transition-colors" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <!-- Gooseneck Wall Arm -->
                  <path d="M15 25 L35 25 Q50 25 50 40 L50 46" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none"/>
                  <!-- Top Mounting Flange -->
                  <rect x="10" y="16" width="10" height="20" rx="2" fill="#1e293b" stroke="currentColor" stroke-width="2"/>
                  <!-- Rotating PTZ Sphere -->
                  <circle cx="50" cy="62" r="22" fill="#0f172a" stroke="currentColor" stroke-width="2"/>
                  <!-- Turret Lens Bezel -->
                  <circle cx="50" cy="64" r="11" fill="#020617" stroke="#38bdf8" stroke-width="2"/>
                  <!-- Optical Glass Lens -->
                  <circle cx="50" cy="64" r="5" fill="#0ea5e9"/>
                  <circle cx="48" cy="62" r="2" fill="#e0f2fe"/>
                  <!-- Dual Pan/Tilt Guide Marks -->
                  <path d="M30 62 L34 62 M66 62 L70 62" stroke="#38bdf8" stroke-width="2"/>
                </svg>
              )}

              {item.type === 'nvr' && (
                <svg class="w-24 h-24 text-slate-400 group-hover:text-cyan-400 transition-colors" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <!-- 1U Rack Chassis Body -->
                  <rect x="10" y="38" width="80" height="24" rx="3" fill="#0f172a" stroke="currentColor" stroke-width="2"/>
                  <!-- Front Panel Bezel Line -->
                  <line x1="12" y1="52" x2="88" y2="52" stroke="#1e293b" stroke-width="1"/>
                  <!-- Ventilation Slots -->
                  <line x1="16" y1="44" x2="36" y2="44" stroke="#334155" stroke-width="1.5" stroke-dasharray="2 2"/>
                  <line x1="16" y1="47" x2="36" y2="47" stroke="#334155" stroke-width="1.5" stroke-dasharray="2 2"/>
                  <!-- Status LEDs -->
                  <circle cx="70" cy="45" r="2" fill="#10b981"/>
                  <circle cx="76" cy="45" r="2" fill="#38bdf8"/>
                  <circle cx="82" cy="45" r="2" fill="#f59e0b"/>
                  <!-- Front USB Port -->
                  <rect x="73" y="55" width="8" height="3" fill="#1e293b" stroke="#475569" stroke-width="1"/>
                </svg>
              )}

              <span class="absolute top-2.5 right-2.5 text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-900 border border-slate-800 text-cyan-400 font-semibold">
                {item.badge}
              </span>
            </div>

            <span class="text-[10px] font-mono uppercase tracking-wider text-cyan-400 font-semibold">
              {item.category}
            </span>
            <h3 class="text-base font-bold text-white mt-1 mb-2">
              {item.title}
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-5">
              {item.description}
            </p>
            
            <ul class="space-y-2 mb-6">
              {item.specs.map((spec) => (
                <li class="flex items-center gap-2 text-xs text-slate-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-cyan-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span>{spec}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href="#contact"
            class="w-full inline-flex items-center justify-center py-2.5 rounded-lg text-xs font-semibold text-slate-200 bg-slate-800 hover:bg-cyan-400 hover:text-slate-950 transition-all duration-200"
          >
            Inquire Specifications & Pricing &rarr;
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
