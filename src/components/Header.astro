---
import { nav, site } from '../data/site';
const phone = site.contacts[0];
const mobileNav = [
  { label: 'Home', href: '#top' },
  { label: 'About Us', href: '#about' },
  { label: 'Solutions', href: '#solutions' },
  { label: 'Services', href: '#services' },
  { label: 'Contact Us', href: '#contact' },
];
---

<header class="site-header" id="top">
  <div class="wrap hbar">
    <a class="logo" href="#top" aria-label="YONAM CCTV Surveillance, home">
      <span class="lt"><img src="/yonam-logo.png" alt="YONAM CCTV Surveillance" width="1208" height="1095" fetchpriority="high" /></span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) =>
            'children' in item ? (
              <li class="has-sub">
                <a class="nl" href={item.href} aria-haspopup="true">
                  {item.label}
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" />
                  </svg>
                </a>
                <div class="sub">
                  {item.children.map((c) => (
                    <a href={item.href}>
                      {c.label}
                      {'note' in c && <small>{c.note}</small>}
                    </a>
                  ))}
                </div>
              </li>
            ) : (
              <li>
                <a class="nl" href={item.href}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a class="nl hph" href={`tel:${phone.tel}`} aria-label={`Call ${phone.display}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>{phone.display}
      </a>
      <a class="btn btn-sm hcta" href="#contact">Discuss Your Project</a>
    </nav>
    <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet"><i></i><i></i><i></i></button>
  </div>
  <div class="prog" aria-hidden="true"><i id="prog"></i></div>
</header>

<div class="sheet-ov" id="ov"></div>
<aside class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1">
  <div class="sh-head">
    <span class="lt"><img src="/yonam-logo.png" alt="YONAM CCTV Surveillance" width="1208" height="1095" /></span>
    <button class="sh-close" id="closeBtn" type="button" aria-label="Close menu"><svg viewBox="0 0 20 20"><path d="M4 4l12 12M16 4L4 16"></path></svg></button>
  </div>
  <nav aria-label="Mobile">
    {mobileNav.map((i) => <a class="m" href={i.href}>{i.label}</a>)}
  </nav>
  <div class="pad">
    <a class="btn" href="#contact">Discuss Your Project</a>
    <p class="ph">{site.contacts.map((c) => <a href={`tel:${c.tel}`}>{c.name} · {c.display}</a>)}</p>
  </div>
</aside>
