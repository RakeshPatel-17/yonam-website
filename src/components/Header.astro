---
interface Props {
  currentPage?: string;
}

const { currentPage = '/' } = Astro.props;
---

<header class="site-header sticky top-0 z-50 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded-lg p-1">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <circle cx="12" cy="11" r="3"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-wider text-white">YONAM</span>
          <span class="text-xs uppercase tracking-widest text-cyan-400 font-medium">Security Solutions</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
        <ul class="flex items-center gap-6 text-sm font-medium">
          <li>
            <a 
              href="/" 
              class={`transition-colors duration-150 hover:text-cyan-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded px-2 py-1 ${currentPage === '/' ? 'text-cyan-400 font-semibold' : 'text-slate-300'}`}
              aria-current={currentPage === '/' ? 'page' : undefined}
            >
              Home
            </a>
          </li>
          <li>
            <a 
              href="#services" 
              class="text-slate-300 hover:text-cyan-400 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded px-2 py-1"
            >
              Services
            </a>
          </li>
          <li>
            <a 
              href="#products" 
              class="text-slate-300 hover:text-cyan-400 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded px-2 py-1"
            >
              Cameras
            </a>
          </li>
          <li>
            <a 
              href="#calculator" 
              class="text-slate-300 hover:text-cyan-400 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded px-2 py-1"
            >
              Estimator
            </a>
          </li>
          <li>
            <a 
              href="#why-us" 
              class="text-slate-300 hover:text-cyan-400 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded px-2 py-1"
            >
              Why YONAM
            </a>
          </li>
          <li>
            <a 
              href="#contact" 
              class="text-slate-300 hover:text-cyan-400 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded px-2 py-1"
            >
              Contact
            </a>
          </li>
        </ul>

        <!-- Action CTA Buttons -->
        <div class="flex items-center gap-4">
          <a
            href="tel:+919876543210"
            class="hidden lg:flex items-center gap-2 text-xs font-semibold text-slate-300 hover:text-white transition-colors"
            title="Call YONAM Support"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>24/7 Help Desk</span>
          </a>

          <a
            href="#contact"
            class="inline-flex items-center justify-center px-4 py-2 rounded-lg text-sm font-semibold text-slate-950 bg-gradient-to-r from-cyan-400 to-cyan-300 hover:from-cyan-300 hover:to-cyan-200 shadow-md shadow-cyan-500/20 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
          >
            Get Free Quote
          </a>
        </div>
      </nav>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden items-center gap-3">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-xs font-semibold text-slate-950 bg-cyan-400 hover:bg-cyan-300 transition-colors"
        >
          Quote
        </a>
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Collapsible Navigation Menu -->
  <div id="mobile-nav" class="hidden md:hidden border-t border-slate-800 bg-slate-900/98 px-4 pt-4 pb-6 space-y-3">
    <nav aria-label="Mobile Navigation">
      <ul class="space-y-2 text-base font-medium">
        <li>
          <a
            href="/"
            class="block px-3 py-2 rounded-md text-cyan-400 bg-slate-800/60 font-semibold"
            aria-current={currentPage === '/' ? 'page' : undefined}
          >
            Home
          </a>
        </li>
        <li>
          <a
            href="#services"
            class="block px-3 py-2 rounded-md text-slate-300 hover:text-white hover:bg-slate-800/40"
          >
            Services & Solutions
          </a>
        </li>
        <li>
          <a
            href="#products"
            class="block px-3 py-2 rounded-md text-slate-300 hover:text-white hover:bg-slate-800/40"
          >
            Cameras & Hardware
          </a>
        </li>
        <li>
          <a
            href="#calculator"
            class="block px-3 py-2 rounded-md text-slate-300 hover:text-white hover:bg-slate-800/40"
          >
            System Estimator
          </a>
        </li>
        <li>
          <a
            href="#why-us"
            class="block px-3 py-2 rounded-md text-slate-300 hover:text-white hover:bg-slate-800/40"
          >
            Why Choose YONAM
          </a>
        </li>
        <li>
          <a
            href="#contact"
            class="block px-3 py-2 rounded-md text-slate-300 hover:text-white hover:bg-slate-800/40"
          >
            Contact & Consultation
          </a>
        </li>
      </ul>
      <div class="pt-4 border-t border-slate-800 mt-4 flex flex-col gap-3">
        <a
          href="tel:+919876543210"
          class="flex items-center justify-center gap-2 py-2.5 rounded-lg border border-slate-700 text-sm font-semibold text-slate-300 hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Call 24/7 Support</span>
        </a>
        <a
          href="#contact"
          class="flex items-center justify-center py-2.5 rounded-lg bg-cyan-400 text-slate-950 font-semibold text-sm hover:bg-cyan-300"
        >
          Request Free Site Survey
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Close mobile nav when clicking any nav link
    const links = mobileNav.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileNav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>

