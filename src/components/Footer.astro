---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Column 1: Brand Info -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-md shadow-cyan-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <circle cx="12" cy="11" r="3"/>
            </svg>
          </div>
          <span class="text-xl font-bold tracking-wider text-white">YONAM</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Premium CCTV surveillance, smart access control, and electronic security solutions. Dedicated to safety, high-definition recording, and 24/7 reliability.
        </p>
        <div class="pt-2 text-xs text-slate-400">
          <span class="text-cyan-400 font-semibold">Emergency Support:</span> Available 24/7
        </div>
      </div>

      <!-- Column 2: Solutions -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Security Solutions</h2>
        <ul class="space-y-2.5 text-xs">
          <li><a href="#services" class="hover:text-cyan-400 transition-colors">Commercial CCTV Systems</a></li>
          <li><a href="#services" class="hover:text-cyan-400 transition-colors">Residential Home Security</a></li>
          <li><a href="#services" class="hover:text-cyan-400 transition-colors">Biometric & RFID Access Control</a></li>
          <li><a href="#services" class="hover:text-cyan-400 transition-colors">24/7 IP Cloud Video Surveillance</a></li>
          <li><a href="#services" class="hover:text-cyan-400 transition-colors">Annual Maintenance Contracts (AMC)</a></li>
        </ul>
      </div>

      <!-- Column 3: Hardware & Cameras -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Surveillance Cameras</h2>
        <ul class="space-y-2.5 text-xs">
          <li><a href="#products" class="hover:text-cyan-400 transition-colors">4K Ultra HD IP Cameras</a></li>
          <li><a href="#products" class="hover:text-cyan-400 transition-colors">Pan-Tilt-Zoom (PTZ) Systems</a></li>
          <li><a href="#products" class="hover:text-cyan-400 transition-colors">Infrared & Color Night Vision</a></li>
          <li><a href="#products" class="hover:text-cyan-400 transition-colors">NVR & Network Video Recorders</a></li>
          <li><a href="#products" class="hover:text-cyan-400 transition-colors">AI Motion & Vehicle Analytics</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Office -->
      <div id="contact" class="space-y-3">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Contact & Support</h2>
        <p class="text-xs text-slate-400 flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Serving Commercial, Industrial & Residential Clients</span>
        </p>
        <p class="text-xs text-slate-400 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <a href="tel:+919876543210" class="hover:text-cyan-400 transition-colors">+91 98765 43210</a>
        </p>
        <p class="text-xs text-slate-400 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <a href="mailto:info@yonamsecurity.com" class="hover:text-cyan-400 transition-colors">info@yonamsecurity.com</a>
        </p>
        <div class="pt-2">
          <a
            href="mailto:quotes@yonamsecurity.com?subject=Site%20Survey%20Request"
            class="inline-block px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-cyan-400 text-xs font-semibold transition-colors"
          >
            Email For Instant Quote &rarr;
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; {currentYear} YONAM Security Solutions. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-300 transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-slate-300 transition-colors">Security Compliance</a>
      </div>
    </div>
  </div>
</footer>

